// Secrets.example.xcconfig
//
// Copy this file to Config/Secrets.xcconfig and fill in real values.
// Config/Secrets.xcconfig is listed in .gitignore and must never be committed.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Values defined here override the defaults in Base.xcconfig.

// Your Apple Developer Team ID, e.g. ABCDE12345
DEVELOPMENT_TEAM =

// Reverse-DNS prefix you control, e.g. com.yourcompany
APP_BUNDLE_IDENTIFIER_BASE = com.scalingjourney

// Backend base URL, e.g. https:/$()/api.example.com
// (The $() breaks up the "//" so xcconfig does not treat it as a comment.)
SJ_API_BASE_URL =

// Google Sign-In OAuth client ID, e.g. 1234-abcd.apps.googleusercontent.com
SJ_GOOGLE_CLIENT_ID =
